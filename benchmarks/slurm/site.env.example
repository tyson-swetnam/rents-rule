# Site-specific settings for the benchmark jobs. Copy to site.env (gitignored) and edit.
# Every value marked TODO(carc) must come from the CARC environment, not from memory.

# Slurm
RR_PARTITION="TODO(carc)"          # e.g. the GPU partition name
RR_ACCOUNT=""                      # sbatch --account, if required
RR_QOS=""                          # sbatch --qos, if required
RR_GPUS_PER_NODE=8                 # TODO(carc) GPUs per node on RR_PARTITION
RR_GRES="gpu:${RR_GPUS_PER_NODE}"  # --gres value
RR_MPI="pmix"                      # srun --mpi=... (pmix or pmi2); check `srun --mpi=list`

# Environment: module loads or a container. Leave RR_MODULES empty if using a container.
RR_MODULES="TODO(carc) e.g. cuda/12.4 openmpi/4.1 nccl"
RR_CONTAINER=""                    # e.g. /path/to/pytorch-vllm.sif (apptainer --nv)

# Benchmark binaries (built once)
RR_NCCL_TESTS_DIR="TODO(carc)/nccl-tests/build"
RR_OSU_DIR="TODO(carc)/osu-micro-benchmarks/libexec/osu-micro-benchmarks/mpi"
RR_PERFTEST_DIR=""                 # empty = use ib_write_bw from PATH
RR_NVBANDWIDTH=""                  # path to nvbandwidth binary, or empty to use CUDA samples p2pBandwidthLatencyTest
RR_IB_DEVICE="mlx5_0"              # HCA for perftest

# Inference
RR_MODEL="TODO(carc) e.g. /path/to/models/Llama-3.1-8B-Instruct"
RR_VLLM_PORT=8000
RR_INFER_RATES="1 4 16"            # requests per second to sweep
RR_INFER_DURATION=300              # seconds per rate
RR_TP_LIST="1 2 4 8"               # tensor-parallel sizes to sweep on one node

# Output root (must be writable from compute nodes)
RR_RUNS_DIR=""                     # empty = <repo>/runs
