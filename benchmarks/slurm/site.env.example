# Site-specific settings for the benchmark jobs. Copy to site.env (gitignored) and edit.
# Values below come from https://carc.unm.edu/docs (partition tables observed 2026-07-25,
# module names from running-jobs/modules); anything marked TODO(carc) is not documented
# and must be checked on the cluster (`sinfo`, `scontrol show partition`, `module avail`).

# Slurm — Easley (default cluster for the GPU experiments)
RR_PARTITION="h100"                # Easley GPU partitions: h100 (2x H100/node, easley[051-054]) or l40s (4x L40S/node, easley[055-063]);
                                   # both are group-gated via ColdFront; CPU runs use "general" (easley[001-048], 64 cores/node, 2-day limit)
RR_ACCOUNT="TODO(carc)"            # Slurm account (not the login account); see running-jobs/slurm-accounting
RR_QOS=""
RR_GPUS_PER_NODE=2                 # 2 for h100, 4 for l40s
RR_GRES="gpu:${RR_GPUS_PER_NODE}"  # docs use --gres=gpu:N; check `scontrol show node easley051` for typed gres (gpu:h100:2)
RR_MPI="pmix"                      # TODO(carc): confirm with `srun --mpi=list`; openmpi/4.1.7 is the documented MPI
RR_MAX_TASKS_PER_NODE=64           # docs: "On Easley, --ntasks-per-node should be <=64"

# Environment: module loads or a container. CARC uses Lmod; the CUDA-aware OpenMPI build ships
# with a matching UCX (software/cuda-aware-mpi) — load that pair for NCCL/OSU runs.
RR_MODULES="gcc/14.2.0-j33x openmpi/4.1.7-762w"   # TODO(carc): add the cuda module and the CUDA-aware openmpi/ucx pair from `module avail`
RR_CONTAINER=""                    # e.g. an Apptainer/Singularity .sif; docs: `module avail singularity`

# Benchmark binaries (built once, e.g. under /projects/<group>/rents-rule/)
RR_NCCL_TESTS_DIR="TODO(carc)/nccl-tests/build"
RR_OSU_DIR="TODO(carc)/osu-micro-benchmarks/libexec/osu-micro-benchmarks/mpi"
RR_PERFTEST_DIR=""                 # empty = use ib_write_bw from PATH (MLNX_OFED)
RR_NVBANDWIDTH=""                  # path to nvbandwidth, or empty for CUDA samples p2pBandwidthLatencyTest
RR_IB_DEVICE="mlx5_0"              # TODO(carc): confirm HCA name with ibstat; Easley fabric is "NDR" (per-port rate to confirm)

# Inference
RR_MODEL="TODO(carc) e.g. /projects/<group>/models/Llama-3.1-8B-Instruct"
RR_VLLM_PORT=8000
RR_INFER_RATES="1 4 16"
RR_INFER_DURATION=300
RR_TP_LIST="1 2"                   # h100 nodes have 2 GPUs; use "1 2 4" on l40s (PCIe only, no NVLink)

# Output root (must be writable from compute nodes; Easley-local scratch is /easley/scratch/..., 1 TB user quota, 180-day purge)
RR_RUNS_DIR=""                     # empty = <repo>/runs

# Hopper alternative (HDR fabric, A100 nodes in condo/lab partitions; 10 community CPU nodes in "general")
# RR_PARTITION="condo"; RR_GPUS_PER_NODE="TODO(carc)"; RR_MAX_TASKS_PER_NODE=32
